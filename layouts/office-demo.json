{
  "id": "office-demo-root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/office-demo.svg",
  "theme": "ink",
  "font": "Geist Mono",
  "font_size": 13,
  "ui_font": "Geist",
  "background": "#12161d",
  "resizable": false,
  "terminal_padding": [
    10,
    12
  ],
  "colors": {
    "background": "#10141b",
    "foreground": "#e7eef8",
    "accent": "#e0a15a",
    "border": "#2c3548",
    "canvas": "#12161d",
    "chrome": "#161b24",
    "surface": "#1c2433",
    "working": "#5ce08a",
    "blocked": "#ffc14d",
    "done": "#4fd6e8",
    "idle": "#8b97aa"
  },
  "children": [
    {
      "id": "office-header",
      "type": "block",
      "size": {
        "px": 46
      },
      "window_drag": true,
      "content": {
        "mod": "office",
        "props": {
          "role": "header"
        }
      }
    },
    {
      "id": "office-body",
      "type": "column",
      "resizable": true,
      "divider": {
        "width": 4,
        "color": "#12161d"
      },
      "size": {
        "weight": 1
      },
      "children": [
        {
          "id": "office-top",
          "type": "column",
          "resizable": false,
          "size": {
            "weight": 0.9
          },
          "children": [
            {
              "id": "office-floor",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "office",
                "props": {
                  "send": false,
                  "demo": true
                }
              }
            },
            {
              "id": "office-rail",
              "type": "block",
              "size": {
                "px": 34
              },
              "content": {
                "mod": "office",
                "props": {
                  "role": "rail"
                }
              }
            }
          ]
        },
        {
          "id": "office-work-frame",
          "type": "column",
          "resizable": false,
          "size": {
            "weight": 1
          },
          "children": [
            {
              "id": "office-work",
              "type": "block",
              "padding": [
                0,
                10
              ],
              "background": "#0e131a",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 10,
                  "radius": 10,
                  "lone": true,
                  "background": "#10141b",
                  "border": {
                    "width": 1,
                    "color": "#2c3548"
                  },
                  "focus": {
                    "width": 2,
                    "color": "#e0a15a"
                  },
                  "header": {
                    "content": {
                      "mod": "office",
                      "props": {
                        "role": "pane"
                      }
                    },
                    "height": 32,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "office-work-foot",
              "type": "block",
              "size": {
                "px": 10
              },
              "background": "#0e131a",
              "content": {
                "mod": "office",
                "props": {
                  "role": "foot"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
